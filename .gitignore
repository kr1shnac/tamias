__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
*.egg-info/
live_check.db
sbom.json
licenses.csv

# Request logs are local artifacts. `demo/runs/` holds the committed dry-run
# evidence that DEMO.md and demo/RUNBOOK.md read back, so those specific files
# are negated below and stay tracked; anything else a run produces is ignored.
*.db
*.db-journal
demo/runs/
!demo/runs/baseline-*.db
!demo/runs/baseline-*.json
!demo/runs/routed-*.db
!demo/runs/routed-*.json
demo/runs/*.log

# demo/config.env is a machine-local copy of the committed template; the
# synthetic history is regenerated by demo/make_history.py, so neither is
# tracked.
demo/config.env
demo/history/agent-3weeks.db
demo/history/agent-3weeks.json
