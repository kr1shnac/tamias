# Editor defaults so a contributor's editor matches the repository's style
# without per-editor configuration. ruff owns Python formatting (line length
# 100, see pyproject.toml); this only pins the basics every file needs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,toml,yml,yaml,md}]
indent_style = space
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown; do not strip them.
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
