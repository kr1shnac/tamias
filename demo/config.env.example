# Settings for demo/run_arm.sh.  Copy to demo/config.env and edit.
#
# This file is read with `set -a; . demo/config.env`, so every line is
# KEY=value with no spaces around the `=`.  demo/run_arm.sh exports nothing you
# did not put in here, and reads no key out of it.

# The model the agent session starts on, and the one the router switches *away*
# to.  Both ids must appear in the price sheet below, character for character,
# because that is what gets logged as model_requested and model_used.
STRONG_MODEL=
CHEAP_MODEL=

# Path to the price sheet the proxy prices with.  Build one from the public
# OpenRouter catalogue with:
#   .venv/bin/python demo/pick_models.py --emit-toml "$STRONG_MODEL" "$CHEAP_MODEL" \
#     > demo/prices.toml
PRICES=

# Base URL of the OpenAI-compatible upstream, WITHOUT /v1/chat/completions --
# tamias appends that path itself, so a base ending in /v1 would 404.
UPSTREAM=https://openrouter.ai/api

# Optional extra flag for the routed arm.  Empty means off.  Set it to `easy-low`
# to add `--effort-policy easy-low` to the routed arm's serve call; that only
# works once `tamias serve` grows the flag.
EFFORT_POLICY=