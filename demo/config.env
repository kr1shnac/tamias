# Settings for demo/run_arm.sh.  Copy demo/config.env.example to demo/config.env
# and edit.  This copy is what the dry runs and tomorrow's live runs both read.
#
# Read with `set -a; . demo/config.env`, so every line is KEY=value with no
# spaces around the `=`.  No key lives here: OPENROUTER_API_KEY is exported in
# the terminal (see demo/RUNBOOK.md) and tamias forwards the client's
# Authorization header without ever reading a credential from a file.

# The nemotron pair already priced by prices.openrouter-sim.toml, which is what
# the --dry-run rehearsal uses.  Point these at whatever you pick for real; see
# the runbook step 1.
STRONG_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CHEAP_MODEL=nvidia/nemotron-3.5-lightning:free

# Price sheet.  Build one for the two models above with:
#   .venv/bin/python demo/pick_models.py --emit-toml "$STRONG_MODEL" "$CHEAP_MODEL" \
#     > demo/prices.toml
# and set PRICES=demo/prices.toml.  The sim sheet has invented rates but real
# model ids, which is what lets a rehearsal price a real log; its
# `simulated = true` stamp keeps those numbers from reading as money.
PRICES=prices.openrouter-sim.toml

# Base URL without /v1/chat/completions: tamias appends that path itself.
UPSTREAM=https://openrouter.ai/api

# Empty means off.  `easy-low` adds --effort-policy easy-low to the routed arm.
EFFORT_POLICY=